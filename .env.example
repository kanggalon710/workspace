# Copy ke `.env` lokal (untuk dev), atau ke `~/private/fiber-jabnet/config/.env` di cPanel.
# Di production cPanel: file ini di-load lewat path `JABNET_PRIVATE_ROOT/config/.env`.
#
# ── Model security ──
# File ini HANYA untuk konfigurasi infra (DB connection, port, session secret).
# Credentials integrasi per-mitra (Google Maps key, billing API token, MPWA token,
# GenieACS, Meta CAPI, dst) disimpan di tabel `mitra_integrations` di DB.
# Set/ganti via UI /integrations (admin mitra) atau /api/mitras/:id/integrations.
# Tidak ada source-code fallback — semua mitra HARUS set credentials sendiri.

# ── URL & port ──
# URL aplikasi di production (dipakai sebagai Referer untuk Google Places API call).
APP_URL=https://workspace.jabnet.id
# Port untuk dev lokal. Di cPanel Node.js App (Passenger), variable PORT di-inject otomatis — biarkan default di prod.
PORT=3002

# ── MySQL (cPanel) ──
# Di cPanel: nama DB yang sudah dibuat lewat MySQL Databases.
# DB_NAME biasanya sudah ter-prefix `<cpaneluser>_<dbname>` (mis. `jabnet_fiber`).
# PRODUCSI cPanel: pakai DB_SOCKET (Unix socket) — workaround mysql2 v3.22 TCP handshake hang
# issue di MySQL 8.0.42-cll-lve. Set DB_SOCKET, biarkan DB_HOST/DB_PORT kosong/diabaikan.
DB_SOCKET=/var/lib/mysql/mysql.sock
# Fallback TCP — dipakai kalau DB_SOCKET tidak di-set (mis. dev lokal Docker MySQL).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=jabnet_<change_me>
DB_PASSWORD=<change_me>
DB_NAME=jabnet_fiber
# Connection pool size (opsional, default 10).
DB_POOL_LIMIT=10

# ── Dev-only: "Tarik Data dari Production" button (prod → dev DB copy) ──
# Set these ONLY in the dev/staging .env. On production leave them UNSET so the feature
# (button + POST /api/dev/db-sync) stays disabled. The guard also requires DB_NAME to end
# with "_dev" and to differ from PROD_DB_NAME, so production can never copy onto itself.
# DEV_DB_SYNC_ENABLED=true
# PROD_DB_NAME=jabnet_fiber

# ── Auth & session ──
# SESSION_SECRET dihapus (2026-10-04): express-session tidak dipakai lagi - auth pakai
# bearer token + cookie ftth_session (bukan session middleware).
# Password admin pertama saat seed (hanya dipakai jika tabel `users` masih kosong).
# WAJIB diisi untuk fresh install - server menolak start tanpa ini saat DB kosong.
# JANGAN pakai password yang pernah terdokumentasi. Generate: `openssl rand -base64 18`
# Identitas opsional: ADMIN_USERNAME (default chief0012), ADMIN_NAME (default Administrator).
ADMIN_DEFAULT_PASSWORD=

# ── Shared infrastructure secrets ──
# Token & URL untuk akses billing.jabnet.id API. SHARED antar SEMUA mitra (single billing
# backend di JABNET, mitra dibedakan via `billing_reseller_id` di /integrations).
# WAJIB di-set BILLING_API_TOKEN; tanpa ini billing sync gagal untuk semua mitra.
BILLING_API_TOKEN=
# Optional — kalau kosong default ke "https://billing.jabnet.id/api/pelanggan/list_pelanggan".
BILLING_API_URL=https://billing.jabnet.id/api/pelanggan/list_pelanggan

# ── Photo storage (filesystem, multi-tenant) ──
# Foto bukti canvassing, ODP, lead, bug disimpan di filesystem (bukan base64 di DB).
# Path: <root>/<mitra-slug>/<feature>/YYYY/MM/<id>-<8hex>.jpg
# Default kalau kosong: $JABNET_PRIVATE_ROOT/uploads (cPanel) atau ./uploads (dev local).
# Set explicit kalau perlu lokasi berbeda — wajib chmod 700 + DI LUAR webroot.
JABNET_UPLOAD_ROOT=

# ── Background workers ──
# Karena cPanel ini deploy "prod baru" yang akan running bareng prod existing (103.194.46.164),
# semua worker default DISABLE untuk avoid dual-write ke external services (MikroTik, billing,
# WhatsApp). Set ke `true` per-worker setelah ditentukan strategi.
WORKERS_ENABLED=false
BILLING_SYNC_ENABLED=false
TRAFFIC_SNAPSHOT_ENABLED=false
SLA_ESCALATION_ENABLED=false
CSAT_SCHEDULER_ENABLED=false
BOOST_EXPIRE_ENABLED=false
BROADCAST_WORKER_ENABLED=false
# v5.0 Teamspace: scheduler check-in rutin (notifikasi in-app + WA via MPWA)
TEAMSPACE_WORKER_ENABLED=false
# Base URL untuk link di pesan WA check-in (default https://workspace.jabnet.id)
# APP_PUBLIC_URL=https://workspace.jabnet.id

# P4c — secret for the pipeline time-trigger cron tick (POST /api/pipelines/automation/tick).
# Leave unset to disable the endpoint (returns 503). Set the same value in the cPanel cron's
# curl header: -H "X-Automation-Secret: <value>".
PIPELINE_TICK_SECRET=

# Expose OTP plaintext di response /api/portal/auth/request-otp untuk testing LOKAL.
# Hanya efektif bila NODE_ENV != production. JANGAN set di server mana pun yang publik.
OTP_DEV_EXPOSE=false
